<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.project.fisionettest.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_admin_dashboard"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.project.fisionettest.ui.auth.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_register_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.project.fisionettest.ui.dashboard.DashboardFragment"
        android:label="Dashboard">
        <action
            android:id="@+id/action_dashboard_to_add_patient"
            app:destination="@id/addPatientFragment" />
        <action
            android:id="@+id/action_dashboard_to_patients"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_dashboard_to_active_patients"
            app:destination="@id/activePatientsFragment" />
        <action
            android:id="@+id/action_dashboard_to_cashier"
            app:destination="@id/cashierMenuFragment" />
        <action
            android:id="@+id/action_dashboard_to_report"
            app:destination="@id/reportFragment" />
        <action
            android:id="@+id/action_dashboard_to_transaction_history"
            app:destination="@id/transactionHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.project.fisionettest.ui.home.HomeFragment"
        android:label="Pasien">
        <action
            android:id="@+id/action_home_to_patient_detail"
            app:destination="@id/patientDetailFragment" />
        <action
            android:id="@+id/action_home_to_add_patient"
            app:destination="@id/addPatientFragment" />
    </fragment>

    <fragment
        android:id="@+id/appointmentFragment"
        android:name="com.project.fisionettest.ui.appointment.AppointmentFragment"
        android:label="Appointment" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.project.fisionettest.ui.profile.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_profile_to_therapist_profile"
            app:destination="@id/therapistProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/therapistProfileFragment"
        android:name="com.project.fisionettest.ui.profile.TherapistProfileFragment"
        android:label="Profil Terapis"
        tools:layout="@layout/fragment_therapist_profile" />

    <fragment
        android:id="@+id/patientDetailFragment"
        android:name="com.project.fisionettest.ui.patient.PatientDetailFragment"
        android:label="fragment_patient_detail"
        tools:layout="@layout/fragment_patient_detail">
        <argument
            android:name="patientId"
            app:argType="integer" />
        <action
            android:id="@+id/action_patient_detail_to_edit"
            app:destination="@id/editPatientFragment" />
        <action
            android:id="@+id/action_patient_detail_to_add_diagnosis"
            app:destination="@id/addDiagnosisFragment" />
        <action
            android:id="@+id/action_patient_detail_to_diagnosis_detail"
            app:destination="@id/diagnosisDetailFragment" />
        <action
            android:id="@+id/action_patient_detail_to_transaction_history"
            app:destination="@id/transactionHistoryFragment" />
        <action
            android:id="@+id/action_patient_detail_to_receipt"
            app:destination="@id/receiptFragment" />
    </fragment>

    <fragment
        android:id="@+id/diagnosisDetailFragment"
        android:name="com.project.fisionettest.ui.patient.DiagnosisDetailFragment"
        android:label="Detail Diagnosis"
        tools:layout="@layout/fragment_diagnosis_detail">
        <argument
            android:name="diagnosis"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/addPatientFragment"
        android:name="com.project.fisionettest.ui.patient.AddPatientFragment"
        android:label="Tambah Pasien">
        <action
            android:id="@+id/action_addPatientFragment_to_addDiagnosisFragment"
            app:destination="@id/addDiagnosisFragment" />
    </fragment>

    <fragment
        android:id="@+id/editPatientFragment"
        android:name="com.project.fisionettest.ui.patient.EditPatientFragment"
        android:label="Edit Pasien">
        <argument
            android:name="patientId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/addDiagnosisFragment"
        android:name="com.project.fisionettest.ui.patient.AddDiagnosisFragment"
        android:label="Tambah Diagnosis">
        <argument
            android:name="patientId"
            android:defaultValue="0"
            app:argType="integer" />
        <action
            android:id="@+id/action_addDiagnosisFragment_to_patientDetailFragment"
            app:destination="@id/patientDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/cashierMenuFragment"
        android:name="com.project.fisionettest.ui.cashier.CashierMenuFragment"
        android:label="Menu Kasir">
        <action
            android:id="@+id/action_cashierMenu_to_addTransaction"
            app:destination="@id/cashierFragment" />
        <action
            android:id="@+id/action_cashierMenu_to_history"
            app:destination="@id/transactionHistoryFragment" />
        <action
            android:id="@+id/action_cashierMenu_to_packageList"
            app:destination="@id/packageListFragment" />
    </fragment>

    <fragment
        android:id="@+id/packageListFragment"
        android:name="com.project.fisionettest.ui.cashier.PackageListFragment"
        android:label="Daftar Paket" />

    <fragment
        android:id="@+id/cashierFragment"
        android:name="com.project.fisionettest.ui.cashier.CashierFragment"
        android:label="Tambah Transaksi">
        <action
            android:id="@+id/action_cashierFragment_to_transactionHistoryFragment"
            app:destination="@id/transactionHistoryFragment" />
        <action
            android:id="@+id/action_cashierFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />
    </fragment>

    <fragment
        android:id="@+id/transactionHistoryFragment"
        android:name="com.project.fisionettest.ui.cashier.TransactionHistoryFragment"
        android:label="Riwayat Transaksi">
        <argument
            android:name="patientId"
            app:argType="integer"
            android:defaultValue="-1" />
        <action
            android:id="@+id/action_transactionHistoryFragment_to_transactionDetailFragment"
            app:destination="@id/transactionDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/transactionDetailFragment"
        android:name="com.project.fisionettest.ui.cashier.TransactionDetailFragment"
        android:label="Detail Transaksi"
        tools:layout="@layout/fragment_transaction_detail">
        <argument
            android:name="transactionId"
            app:argType="integer" />
        <action
            android:id="@+id/action_transactionDetail_to_payment"
            app:destination="@id/paymentFragment" />
    </fragment>

    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.project.fisionettest.ui.cashier.PaymentFragment"
        android:label="Pembayaran WebView"
        tools:layout="@layout/fragment_payment">
        <argument
            android:name="paymentUrl"
            app:argType="string" />
        <argument
            android:name="transactionId"
            app:argType="integer" />
        <action
            android:id="@+id/action_paymentFragment_to_transactionHistoryFragment"
            app:destination="@id/transactionHistoryFragment"
            app:popUpTo="@id/cashierMenuFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.project.fisionettest.ui.admin.AdminDashboardFragment"
        android:label="Admin Dashboard">
        <action
            android:id="@+id/action_adminDashboard_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_adminDashboard_to_report"
            app:destination="@id/reportFragment" />
        <action
            android:id="@+id/action_adminDashboard_to_patientDetail"
            app:destination="@id/patientDetailFragment" />
        <action
            android:id="@+id/action_adminDashboard_to_addPatient"
            app:destination="@id/addPatientFragment" />
    </fragment>

    <fragment
        android:id="@+id/reportFragment"
        android:name="com.project.fisionettest.ui.dashboard.ReportFragment"
        android:label="Cetak Laporan"
        tools:layout="@layout/fragment_report">
        <argument
            android:name="isAdmin"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <fragment
        android:id="@+id/activePatientsFragment"
        android:name="com.project.fisionettest.ui.home.ActivePatientsFragment"
        android:label="Pasien yang Dilayani"
        tools:layout="@layout/fragment_active_patients">
        <action
            android:id="@+id/action_active_patients_to_patient_detail"
            app:destination="@id/patientDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/receiptFragment"
        android:name="com.project.fisionettest.ui.cashier.ReceiptFragment"
        android:label="Struk Pembayaran"
        tools:layout="@layout/fragment_receipt">
        <argument
            android:name="transactionId"
            app:argType="integer" />
        <action
            android:id="@+id/action_receipt_to_payment"
            app:destination="@id/paymentFragment" />
    </fragment>

</navigation>
